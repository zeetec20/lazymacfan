{
  "name": "lazymacfan",
  "version": "0.5.0",
  "description": "Lightweight macOS TUI application and background fan controller",
  "type": "module",
  "main": "src/cli/index.ts",
  "bin": {
    "lazymacfan": "./dist/lazymacfan"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "build:release": "scripts/build-release.sh",
    "test": "bun --bun x vitest run",
    "test:bun": "bun test",
    "test:unit": "bun test tests/unit",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@opentui/core": "^0.5.12",
    "@opentui/core-darwin-x64": "^0.5.12",
    "@opentui/react": "^0.5.12",
    "react": "^19.0.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "lefthook": "^2.2.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ]
}
