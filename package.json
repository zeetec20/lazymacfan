{
  "name": "lazymacfan",
  "version": "0.1.0",
  "description": "Lightweight macOS TUI application and background fan controller",
  "type": "module",
  "main": "src/cli/index.ts",
  "bin": {
    "lazymacfan": "./dist/lazymacfan"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun --bun x vitest run",
    "test:bun": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write src tests scripts",
    "format:check": "oxfmt --check src tests scripts"
  },
  "dependencies": {
    "@opentui/core": "^0.5.12",
    "@opentui/core-darwin-x64": "^0.5.12",
    "@opentui/react": "^0.5.12",
    "react": "^19.0.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ]
}
